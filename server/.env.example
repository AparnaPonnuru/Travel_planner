# ═══════════════════════════════════════════════
# VoyageAI Environment Configuration
# ═══════════════════════════════════════════════

# ── MongoDB Atlas ──
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/voyageai?retryWrites=true&w=majority

# ── JWT Secret ──
JWT_SECRET=voyage-ai-super-secure-secret-key-2026

# ── Python Agent Service URL ──
AGENT_SERVICE_URL=http://localhost:8000

# ── Client URL (for CORS) ──
CLIENT_URL=http://localhost:5173

# ── Server Port ──
PORT=5000
